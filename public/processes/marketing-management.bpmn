<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RaschiniMarketing" targetNamespace="https://raschini.com/bpmn/marketing-management">
  <bpmn:process id="Process_RaschiniMarketing" name="Управление маркетингом Raschini" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Marketing">
      <bpmn:lane id="Lane_CEO" name="CEO">
        <bpmn:flowNodeRef>Task_ApproveStrategy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StrategyApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovePlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlanApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CEOReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StrategyChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CMO" name="Директор по маркетингу">
        <bpmn:flowNodeRef>Start_AnnualCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeContext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftStrategy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanBudgetCalendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonthlyPlanning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportingSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MonthMetrics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProjectAnalysis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReportingJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CorrectPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_NextMonth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QuarterlyStrategyReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Team" name="Маркетинговая команда">
        <bpmn:flowNodeRef>Task_DecomposeTasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteActivities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FactSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FactJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Финансы / бухгалтерия">
        <bpmn:flowNodeRef>Task_RecordExpenses</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analytics" name="Аналитика / 1С / RetailCRM / digital">
        <bpmn:flowNodeRef>Task_CollectResults</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_AnnualCycle" name="Начало годового цикла">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Annual"/>
    </bpmn:startEvent>
    <bpmn:task id="Task_AnalyzeContext" name="Проанализировать бизнес-цели, продажи и прошлые результаты">
      <bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Task_DraftStrategy" name="Разработать маркетинговую стратегию" triggeredByEvent="false">
      <bpmn:incoming>Flow_02</bpmn:incoming><bpmn:incoming>Flow_04_No</bpmn:incoming><bpmn:incoming>Flow_25_Yes</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing>
    <bpmn:startEvent id="Task_DraftStrategy_nested_start" name="Начало"/><bpmn:task id="Task_DraftStrategy_nested_1" name="Собрать цели продаж, ассортимент и результаты прошлого периода"/><bpmn:task id="Task_DraftStrategy_nested_2" name="Описать аудитории, позиционирование, каналы и KPI"/><bpmn:task id="Task_DraftStrategy_nested_3" name="Подготовить стратегию для решения CEO"/><bpmn:endEvent id="Task_DraftStrategy_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_DraftStrategy_nested_flow_Task_DraftStrategy_nested_1" sourceRef="Task_DraftStrategy_nested_start" targetRef="Task_DraftStrategy_nested_1"/><bpmn:sequenceFlow id="Task_DraftStrategy_nested_flow_Task_DraftStrategy_nested_2" sourceRef="Task_DraftStrategy_nested_1" targetRef="Task_DraftStrategy_nested_2"/><bpmn:sequenceFlow id="Task_DraftStrategy_nested_flow_Task_DraftStrategy_nested_3" sourceRef="Task_DraftStrategy_nested_2" targetRef="Task_DraftStrategy_nested_3"/><bpmn:sequenceFlow id="Task_DraftStrategy_nested_flow_Task_DraftStrategy_nested_end" sourceRef="Task_DraftStrategy_nested_3" targetRef="Task_DraftStrategy_nested_end"/></bpmn:subProcess>
    <bpmn:userTask id="Task_ApproveStrategy" name="Рассмотреть стратегию">
      <bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_StrategyApproved" name="Стратегия утверждена?" default="Flow_04_No">
      <bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_04_Yes</bpmn:outgoing><bpmn:outgoing>Flow_04_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Task_PlanBudgetCalendar" name="Сформировать бюджет и годовой маркетинговый календарь" triggeredByEvent="false">
      <bpmn:incoming>Flow_04_Yes</bpmn:incoming><bpmn:incoming>Flow_06_No</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing>
    <bpmn:startEvent id="Task_PlanBudgetCalendar_nested_start" name="Начало"/><bpmn:task id="Task_PlanBudgetCalendar_nested_1" name="Разнести лимиты и план оплат"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1V1GiCOuRp3qecUxt6T8xG3p9ExIveFrThuvDsTX6XmE/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_PlanBudgetCalendar_nested_2" name="Внести проекты, даты, KPI и ID в календарь"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1w0ku7FxFU8AlI45-6U-kqO0RDQFx7qAqmG8UsjjsZQU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_PlanBudgetCalendar_nested_3" name="Сверить бюджет и календарь"/><bpmn:endEvent id="Task_PlanBudgetCalendar_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_PlanBudgetCalendar_nested_flow_Task_PlanBudgetCalendar_nested_1" sourceRef="Task_PlanBudgetCalendar_nested_start" targetRef="Task_PlanBudgetCalendar_nested_1"/><bpmn:sequenceFlow id="Task_PlanBudgetCalendar_nested_flow_Task_PlanBudgetCalendar_nested_2" sourceRef="Task_PlanBudgetCalendar_nested_1" targetRef="Task_PlanBudgetCalendar_nested_2"/><bpmn:sequenceFlow id="Task_PlanBudgetCalendar_nested_flow_Task_PlanBudgetCalendar_nested_3" sourceRef="Task_PlanBudgetCalendar_nested_2" targetRef="Task_PlanBudgetCalendar_nested_3"/><bpmn:sequenceFlow id="Task_PlanBudgetCalendar_nested_flow_Task_PlanBudgetCalendar_nested_end" sourceRef="Task_PlanBudgetCalendar_nested_3" targetRef="Task_PlanBudgetCalendar_nested_end"/></bpmn:subProcess>
    <bpmn:userTask id="Task_ApprovePlan" name="Утвердить бюджет и календарь">
      <bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PlanApproved" name="План утверждён?" default="Flow_06_No">
      <bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_06_Yes</bpmn:outgoing><bpmn:outgoing>Flow_06_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Task_MonthlyPlanning" name="Уточнить проекты месяца и присвоить ID" triggeredByEvent="false">
      <bpmn:incoming>Flow_06_Yes</bpmn:incoming><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing>
    <bpmn:startEvent id="Task_MonthlyPlanning_nested_start" name="Начало"/><bpmn:task id="Task_MonthlyPlanning_nested_1" name="Отобрать проекты месяца по ID"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1w0ku7FxFU8AlI45-6U-kqO0RDQFx7qAqmG8UsjjsZQU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_MonthlyPlanning_nested_2" name="Уточнить суммы, KPI и сроки"/><bpmn:task id="Task_MonthlyPlanning_nested_3" name="Передать задачи команде"/><bpmn:endEvent id="Task_MonthlyPlanning_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_MonthlyPlanning_nested_flow_Task_MonthlyPlanning_nested_1" sourceRef="Task_MonthlyPlanning_nested_start" targetRef="Task_MonthlyPlanning_nested_1"/><bpmn:sequenceFlow id="Task_MonthlyPlanning_nested_flow_Task_MonthlyPlanning_nested_2" sourceRef="Task_MonthlyPlanning_nested_1" targetRef="Task_MonthlyPlanning_nested_2"/><bpmn:sequenceFlow id="Task_MonthlyPlanning_nested_flow_Task_MonthlyPlanning_nested_3" sourceRef="Task_MonthlyPlanning_nested_2" targetRef="Task_MonthlyPlanning_nested_3"/><bpmn:sequenceFlow id="Task_MonthlyPlanning_nested_flow_Task_MonthlyPlanning_nested_end" sourceRef="Task_MonthlyPlanning_nested_3" targetRef="Task_MonthlyPlanning_nested_end"/></bpmn:subProcess>
    <bpmn:task id="Task_DecomposeTasks" name="Декомпозировать проекты в задачи, назначить сроки и ответственных">
      <bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Task_ExecuteActivities" name="Реализовать проекты и публикации" triggeredByEvent="false">
      <bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing>
    <bpmn:startEvent id="Task_ExecuteActivities_nested_start" name="Начало"/><bpmn:task id="Task_ExecuteActivities_nested_1" name="Утвердить бриф, материалы и метки"/><bpmn:task id="Task_ExecuteActivities_nested_2" name="Запустить публикацию или мероприятие"/><bpmn:task id="Task_ExecuteActivities_nested_3" name="Сохранить ссылки, даты и отклонения"/><bpmn:endEvent id="Task_ExecuteActivities_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_ExecuteActivities_nested_flow_Task_ExecuteActivities_nested_1" sourceRef="Task_ExecuteActivities_nested_start" targetRef="Task_ExecuteActivities_nested_1"/><bpmn:sequenceFlow id="Task_ExecuteActivities_nested_flow_Task_ExecuteActivities_nested_2" sourceRef="Task_ExecuteActivities_nested_1" targetRef="Task_ExecuteActivities_nested_2"/><bpmn:sequenceFlow id="Task_ExecuteActivities_nested_flow_Task_ExecuteActivities_nested_3" sourceRef="Task_ExecuteActivities_nested_2" targetRef="Task_ExecuteActivities_nested_3"/><bpmn:sequenceFlow id="Task_ExecuteActivities_nested_flow_Task_ExecuteActivities_nested_end" sourceRef="Task_ExecuteActivities_nested_3" targetRef="Task_ExecuteActivities_nested_end"/></bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_FactSplit">
      <bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10A</bpmn:outgoing><bpmn:outgoing>Flow_10B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Task_RecordExpenses" name="Зарегистрировать расход и оплату по ID проекта" triggeredByEvent="false">
      <bpmn:incoming>Flow_10A</bpmn:incoming><bpmn:outgoing>Flow_11A</bpmn:outgoing>
    <bpmn:startEvent id="Task_RecordExpenses_nested_start" name="Начало"/><bpmn:task id="Task_RecordExpenses_nested_1" name="Записать ID проекта, сумму, статью и дату расхода"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1cgDWYhKFcLufiE-1BRyn_LSj9K_B1V8Zi45CeIkUOuU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_RecordExpenses_nested_2" name="Отдельно записать дату оплаты"/><bpmn:task id="Task_RecordExpenses_nested_3" name="Сверить операцию с бюджетом"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1V1GiCOuRp3qecUxt6T8xG3p9ExIveFrThuvDsTX6XmE/edit</bpmn:documentation></bpmn:task><bpmn:endEvent id="Task_RecordExpenses_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_RecordExpenses_nested_flow_Task_RecordExpenses_nested_1" sourceRef="Task_RecordExpenses_nested_start" targetRef="Task_RecordExpenses_nested_1"/><bpmn:sequenceFlow id="Task_RecordExpenses_nested_flow_Task_RecordExpenses_nested_2" sourceRef="Task_RecordExpenses_nested_1" targetRef="Task_RecordExpenses_nested_2"/><bpmn:sequenceFlow id="Task_RecordExpenses_nested_flow_Task_RecordExpenses_nested_3" sourceRef="Task_RecordExpenses_nested_2" targetRef="Task_RecordExpenses_nested_3"/><bpmn:sequenceFlow id="Task_RecordExpenses_nested_flow_Task_RecordExpenses_nested_end" sourceRef="Task_RecordExpenses_nested_3" targetRef="Task_RecordExpenses_nested_end"/></bpmn:subProcess>
    <bpmn:subProcess id="Task_CollectResults" name="Собрать охваты, трафик, лиды, покупки и выручку" triggeredByEvent="false">
      <bpmn:incoming>Flow_10B</bpmn:incoming><bpmn:outgoing>Flow_11B</bpmn:outgoing>
    <bpmn:startEvent id="Task_CollectResults_nested_start" name="Начало"/><bpmn:task id="Task_CollectResults_nested_1" name="Собрать фактические даты, охват и трафик"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1cgDWYhKFcLufiE-1BRyn_LSj9K_B1V8Zi45CeIkUOuU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_CollectResults_nested_2" name="Сверить обращения, визиты и продажи с CRM и 1С"/><bpmn:task id="Task_CollectResults_nested_3" name="Связать результат с ID проекта"/><bpmn:endEvent id="Task_CollectResults_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_CollectResults_nested_flow_Task_CollectResults_nested_1" sourceRef="Task_CollectResults_nested_start" targetRef="Task_CollectResults_nested_1"/><bpmn:sequenceFlow id="Task_CollectResults_nested_flow_Task_CollectResults_nested_2" sourceRef="Task_CollectResults_nested_1" targetRef="Task_CollectResults_nested_2"/><bpmn:sequenceFlow id="Task_CollectResults_nested_flow_Task_CollectResults_nested_3" sourceRef="Task_CollectResults_nested_2" targetRef="Task_CollectResults_nested_3"/><bpmn:sequenceFlow id="Task_CollectResults_nested_flow_Task_CollectResults_nested_end" sourceRef="Task_CollectResults_nested_3" targetRef="Task_CollectResults_nested_end"/></bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_FactJoin">
      <bpmn:incoming>Flow_11A</bpmn:incoming><bpmn:incoming>Flow_11B</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_ReportingSplit">
      <bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13A</bpmn:outgoing><bpmn:outgoing>Flow_13B</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Task_MonthMetrics" name="Рассчитать ДРР и ROMI месяца по датам оплаты" triggeredByEvent="false">
      <bpmn:incoming>Flow_13A</bpmn:incoming><bpmn:outgoing>Flow_14A</bpmn:outgoing>
    <bpmn:startEvent id="Task_MonthMetrics_nested_start" name="Начало"/><bpmn:task id="Task_MonthMetrics_nested_1" name="Отобрать операции по дате оплаты месяца"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1cgDWYhKFcLufiE-1BRyn_LSj9K_B1V8Zi45CeIkUOuU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_MonthMetrics_nested_2" name="Рассчитать ДРР и ROMI с указанным определением"/><bpmn:task id="Task_MonthMetrics_nested_3" name="Сверить план-факт и дату среза"/><bpmn:endEvent id="Task_MonthMetrics_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_MonthMetrics_nested_flow_Task_MonthMetrics_nested_1" sourceRef="Task_MonthMetrics_nested_start" targetRef="Task_MonthMetrics_nested_1"/><bpmn:sequenceFlow id="Task_MonthMetrics_nested_flow_Task_MonthMetrics_nested_2" sourceRef="Task_MonthMetrics_nested_1" targetRef="Task_MonthMetrics_nested_2"/><bpmn:sequenceFlow id="Task_MonthMetrics_nested_flow_Task_MonthMetrics_nested_3" sourceRef="Task_MonthMetrics_nested_2" targetRef="Task_MonthMetrics_nested_3"/><bpmn:sequenceFlow id="Task_MonthMetrics_nested_flow_Task_MonthMetrics_nested_end" sourceRef="Task_MonthMetrics_nested_3" targetRef="Task_MonthMetrics_nested_end"/></bpmn:subProcess>
    <bpmn:subProcess id="Task_ProjectAnalysis" name="Оценить проекты по полной стоимости независимо от периода" triggeredByEvent="false">
      <bpmn:incoming>Flow_13B</bpmn:incoming><bpmn:outgoing>Flow_14B</bpmn:outgoing>
    <bpmn:startEvent id="Task_ProjectAnalysis_nested_start" name="Начало"/><bpmn:task id="Task_ProjectAnalysis_nested_1" name="Собрать все затраты по ID без ограничения периодом"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1cgDWYhKFcLufiE-1BRyn_LSj9K_B1V8Zi45CeIkUOuU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_ProjectAnalysis_nested_2" name="Сопоставить стоимость с результатами проекта"/><bpmn:task id="Task_ProjectAnalysis_nested_3" name="Записать решение: повторить, изменить или закрыть"/><bpmn:endEvent id="Task_ProjectAnalysis_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_ProjectAnalysis_nested_flow_Task_ProjectAnalysis_nested_1" sourceRef="Task_ProjectAnalysis_nested_start" targetRef="Task_ProjectAnalysis_nested_1"/><bpmn:sequenceFlow id="Task_ProjectAnalysis_nested_flow_Task_ProjectAnalysis_nested_2" sourceRef="Task_ProjectAnalysis_nested_1" targetRef="Task_ProjectAnalysis_nested_2"/><bpmn:sequenceFlow id="Task_ProjectAnalysis_nested_flow_Task_ProjectAnalysis_nested_3" sourceRef="Task_ProjectAnalysis_nested_2" targetRef="Task_ProjectAnalysis_nested_3"/><bpmn:sequenceFlow id="Task_ProjectAnalysis_nested_flow_Task_ProjectAnalysis_nested_end" sourceRef="Task_ProjectAnalysis_nested_3" targetRef="Task_ProjectAnalysis_nested_end"/></bpmn:subProcess>
    <bpmn:parallelGateway id="Gateway_ReportingJoin">
      <bpmn:incoming>Flow_14A</bpmn:incoming><bpmn:incoming>Flow_14B</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Task_FinalReport" name="Сформировать финальный лист «Показатели»" triggeredByEvent="false">
      <bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing>
    <bpmn:startEvent id="Task_FinalReport_nested_start" name="Начало"/><bpmn:task id="Task_FinalReport_nested_1" name="Сверить месячный и проектный срезы"><bpmn:documentation>Документ: https://docs.google.com/spreadsheets/d/1cgDWYhKFcLufiE-1BRyn_LSj9K_B1V8Zi45CeIkUOuU/edit</bpmn:documentation></bpmn:task><bpmn:task id="Task_FinalReport_nested_2" name="Сформировать лист Показатели и выводы"/><bpmn:task id="Task_FinalReport_nested_3" name="Зафиксировать период и дату актуальности"/><bpmn:endEvent id="Task_FinalReport_nested_end" name="Готово"/><bpmn:sequenceFlow id="Task_FinalReport_nested_flow_Task_FinalReport_nested_1" sourceRef="Task_FinalReport_nested_start" targetRef="Task_FinalReport_nested_1"/><bpmn:sequenceFlow id="Task_FinalReport_nested_flow_Task_FinalReport_nested_2" sourceRef="Task_FinalReport_nested_1" targetRef="Task_FinalReport_nested_2"/><bpmn:sequenceFlow id="Task_FinalReport_nested_flow_Task_FinalReport_nested_3" sourceRef="Task_FinalReport_nested_2" targetRef="Task_FinalReport_nested_3"/><bpmn:sequenceFlow id="Task_FinalReport_nested_flow_Task_FinalReport_nested_end" sourceRef="Task_FinalReport_nested_3" targetRef="Task_FinalReport_nested_end"/></bpmn:subProcess>
    <bpmn:userTask id="Task_CEOReview" name="Провести ежемесячный управленческий разбор">
      <bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_StrategyChange" name="Нужно менять стратегию?" default="Flow_18_No">
      <bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18_Yes</bpmn:outgoing><bpmn:outgoing>Flow_18_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CorrectPlan" name="Скорректировать бюджет, календарь и задачи">
      <bpmn:incoming>Flow_18_No</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_NextMonth" name="Следующий месяц">
      <bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing><bpmn:timerEventDefinition id="Timer_Monthly"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_QuarterlyStrategyReview" name="Провести квартальный пересмотр стратегии">
      <bpmn:incoming>Flow_18_Yes</bpmn:incoming><bpmn:outgoing>Flow_25_Yes</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_AnnualCycle" targetRef="Task_AnalyzeContext"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_AnalyzeContext" targetRef="Task_DraftStrategy"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_DraftStrategy" targetRef="Task_ApproveStrategy"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ApproveStrategy" targetRef="Gateway_StrategyApproved"/>
    <bpmn:sequenceFlow id="Flow_04_Yes" name="Да" sourceRef="Gateway_StrategyApproved" targetRef="Task_PlanBudgetCalendar"/>
    <bpmn:sequenceFlow id="Flow_04_No" name="Нет" sourceRef="Gateway_StrategyApproved" targetRef="Task_DraftStrategy"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_PlanBudgetCalendar" targetRef="Task_ApprovePlan"/>
